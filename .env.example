# Receipts — environment variables
#
# Copy this file to `.env.local` for local development, or set these in your
# Vercel project settings. Never commit real secrets.

# Required: server-side only. Used for the explanation layer and the safety gate.
# Get a key at https://platform.claude.com
ANTHROPIC_API_KEY=

# Optional: override the models used. Defaults are set in lib/config.ts.
# The explanation layer uses the current Claude Sonnet model by design.
# RECEIPTS_EXPLANATION_MODEL=claude-sonnet-4-6
# RECEIPTS_SAFETY_MODEL=claude-sonnet-4-6
